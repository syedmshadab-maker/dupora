/dist/
*.wixpdb

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Rust
/rust/target/
**/*.rs.bk

# Claude Code harness internal state (not project source)
.claude/

# Python (branding/scripts/ generation pipeline)
__pycache__/
*.pyc
